# Copy this file to .env for local development.
# On Render, set these in the service's Environment tab instead of committing a .env file.

# Render injects PORT automatically in production — only used as a local dev default.
PORT=4000

# development | production. Controls CORS strictness, morgan log format, etc.
NODE_ENV=development

# Comma-separated list of allowed frontend origins. Required in production.
# Example: CORS_ORIGIN=https://ai-battle-arena.vercel.app
# In development, localhost:5173/127.0.0.1:5173 are always allowed in addition to this.
CORS_ORIGIN=

# How long an idle session (and the API keys held for it) survives, in ms.
SESSION_TTL_MS=7200000

# Max retry attempts for a provider call before giving up (network/timeout/429/5xx only).
PROVIDER_MAX_RETRIES=2
# Base delay (ms) for exponential backoff between retries.
PROVIDER_RETRY_BASE_MS=400
# Hard timeout (ms) on a single upstream provider call.
PROVIDER_TIMEOUT_MS=20000

# Hard timeout (ms) on the whole incoming request, retries included.
REQUEST_TIMEOUT_MS=55000
